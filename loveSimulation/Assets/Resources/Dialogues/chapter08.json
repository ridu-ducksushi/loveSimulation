    "knight_talk_direct": {
      "lines": [
        {
          "speaker": "",
          "text": "기사단장의 눈이 미세하게 좁아졌다."
        },
        {
          "speaker": "기사단장",
          "text": "...어째서 그리 생각합니까?",
          "emotion": "neutral"
        },
        {
          "speaker": "me",
          "text": "갑옷의 문양이요.\n북부 기사단의 것이잖아요."
